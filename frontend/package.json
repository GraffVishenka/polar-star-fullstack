{
  "name": "polar-star-service-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --pretty false && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.8",
    "@tanstack/react-query": "^5.108.2",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
