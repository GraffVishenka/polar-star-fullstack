# Базовый URL API. В Docker и dev-режиме проксируется nginx/vite на api:8080.
VITE_API_BASE_URL=/api

# MSW-моки по контракту §3.13 (по умолчанию включены только в dev).
# Поставьте false, чтобы ходить в реальный API через proxy http://localhost:8080.
VITE_ENABLE_MSW=true

# Имя приложения до появления публичного эндпоинта настроек.
VITE_APP_NAME=Сервисный центр
