# ---------------------------------------------------------------------------
# Скопируйте в .env и замените секреты. .env в репозиторий не коммитится.
# ---------------------------------------------------------------------------

# Окружение приложения: development | production | test.
APP_ENV=development
# Уровень логов: debug | info | warn | error.
LOG_LEVEL=info

# --- HTTP -------------------------------------------------------------------
PORT=8080
API_PORT=8080
# Разрешённые origin'ы через запятую (CORS). "*" — только локально.
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# --- MySQL ------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=polar_star
MYSQL_USER=polar
MYSQL_PASSWORD=polar
MYSQL_PORT=3306
# DSN; поддерживаются mysql://user:pass@tcp(host:3306)/db и обычный DSN.
DATABASE_URL=mysql://polar:polar@tcp(mysql:3306)/polar_star

# --- Секреты ----------------------------------------------------------------
# NFR-2: не короче 32 символов. Сгенерируйте: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-please-32
# Время жизни токенов (AUTH-2).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
JWT_ISSUER=polar-star-service

# --- Время и календарь ------------------------------------------------------
# CAL-2: IANA-идентификатор. Определяет дедлайны, "сегодня" и джобы.
TZ=Asia/Yekaterinburg

# --- Первичный администратор (AUTH-4) ---------------------------------------
# Пароль не короче 8 символов. Пользователь создаётся один раз (идемпотентный сидинг).
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=ChangeMe_12345
SEED_ADMIN_FULL_NAME=Администратор

# --- Файлы ------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
# 200 МБ — лимит видео (Б3).
MAX_UPLOAD_BYTES=209715200

# --- Web Push (NOTIF-1), обязательно для production -------------------------
# Сгенерируйте: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Прочее -----------------------------------------------------------------
SHUTDOWN_TIMEOUT=15s
TRUST_PROXY=true
OPENAPI_PATH=openapi/openapi.yaml
